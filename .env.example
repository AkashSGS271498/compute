# Worker Configuration
WORKER_HOST=0.0.0.0
WORKER_PORT=8001
WORKER_NAME=laptop-b
LOG_LEVEL=INFO

# Backend Connection
BACKEND_URL=http://127.0.0.1:8000
BACKEND_SECRET=supersecret

# Docker Execution Settings
DOCKER_IMAGE=distributed-compute-python:latest
JOB_CPU_LIMIT=1.0
JOB_MEMORY_LIMIT=512m
JOB_TIMEOUT_SECONDS=30
JOB_NETWORK_DISABLED=true
